# Copy this file to .env and fill in your values.

# --- Database ---
# SQLite file, stored in the project folder. No separate database server needed.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth / Google Workspace SSO) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Random secret used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Only people with this email domain may sign in (your school's Google Workspace domain).
ALLOWED_EMAIL_DOMAIN="davincischools.org"

# Comma-separated emails that are always granted the Admin role on sign-in.
# Put your own email here so you can log in as an admin on day one.
ADMIN_EMAILS="adaramola@davincischools.org"

# Comma-separated emails that are granted the Teacher role on first sign-in
# (admins can also change roles later from the Admin > Users page).
TEACHER_EMAILS=""
